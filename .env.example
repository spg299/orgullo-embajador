# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — server-only, bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com > API Keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Orgullo Embajador <onboarding@resend.dev>"

# Public site URL, used inside email templates and auth redirect links
NEXT_PUBLIC_SITE_URL=https://orgullo-embajador.vercel.app

# Secret used to protect POST /api/notify-tickets until a real admin panel exists.
# Make up any long random string.
ADMIN_NOTIFY_SECRET=
