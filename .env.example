# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret — server-only, bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Email sending — free stopgap via Gmail/Outlook SMTP with an app password,
# until a domain is verified with a real transactional provider (e.g. Resend).
# Gmail: host smtp.gmail.com, port 587
# Outlook/Hotmail: host smtp-mail.outlook.com, port 587
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM="Orgullo Embajador <tu-cuenta@gmail.com>"

# Public site URL, used inside email templates and Supabase auth redirect
# links (emailRedirectTo / redirectTo). OPTIONAL — next.config.ts already
# resolves this automatically: localhost in local dev, and the right Vercel
# URL (production or preview) when deployed. Only set this to force a
# specific value.
# NEXT_PUBLIC_SITE_URL=https://orgullo-embajador.vercel.app

# Secret used to protect POST /api/notify-tickets until a real admin panel exists.
# Make up any long random string.
ADMIN_NOTIFY_SECRET=

# Wompi (Sandbox first — dashboard.wompi.co > Desarrolladores). Card payment
# checkout, second payment method alongside WhatsApp.
# Public key is safe to expose to the browser (it's a public identifier used
# directly in the redirect form to checkout.wompi.co) — pub_test_... in
# Sandbox, pub_prod_... in Production.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
# Secrets — server-only, used to compute the integrity signature on order
# creation and to validate webhook checksums. Never expose to the browser.
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
